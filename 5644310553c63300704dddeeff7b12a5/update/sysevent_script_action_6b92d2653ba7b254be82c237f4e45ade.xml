<?xml version="1.0" encoding="UTF-8"?><record_update sys_domain="global" table="sysevent_script_action">
    <sysevent_script_action action="INSERT_OR_UPDATE">
        <active>true</active>
        <condition_script/>
        <description/>
        <event_name>sn_disco_certmgmt.certificate.captured</event_name>
        <name>BNB Discovery Certificate Captured</name>
        <order>200</order>
        <script><![CDATA[function log(logger, message, level) {
	if (level == "error") {
		logger.error(message);
		gs.error(message);
	} else {
		logger.info(message);
		gs.info(message);
	}
}

function processCertificateHistory(current) {
	var logger = new global.DiscoveryLogger(current.status, null);
	var cert = current.server_certificate;

	// EDX current é um registro de Discovered Certificate(sn_disco_certmgmt_certificate_history)
	if (!cert || !cert.sys_id || !cert.subject_common_name) {
		log(logger, "EDX - Skipping certificate discovered on " + current.source + ':' + current.port);
		return current;
	}

	var fixScope = new sn_disco_certmgmt.BNBFixScopeAndMetadata();

	log(logger, "EDX - Processing Certificate " + cert.subject_common_name + ' - ' + cert.sys_id);
	var updates = fixScope.setActiveCertificateScope(cert.subject_common_name);
	var result = updates[cert.sys_id];
	if (result) {
		log(logger, "EDX - " + result);
	}
}

processCertificateHistory(current);]]></script>
