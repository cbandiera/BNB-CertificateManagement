        <value>(function execute(inputs, outputs) {&#13;
	var today = new GlideDateTime();&#13;
	// today.setValue('2018-05-08');&#13;
&#13;
	var beginOfDay = new GlideDateTime(today.getDate() + " 00:00:00");&#13;
	var endOfDay = new GlideDateTime(today.getDate() + ' 23:59:59');&#13;
&#13;
	var i = 30;&#13;
	var expiraInicio = new GlideDateTime(beginOfDay);&#13;
	expiraInicio.addDaysLocalTime(i);&#13;
	var expiraFim = new GlideDateTime(endOfDay);&#13;
	expiraFim.addDaysLocalTime(i);&#13;
&#13;
	new global.GlideQuery('cmdb_ci_certificate')&#13;
		.where("valid_to", "&gt;=", expiraInicio)&#13;
		.where("valid_to", "&lt;=", expiraFim)&#13;
		.where("is_ca", false)&#13;
		.where("u_ca_scope", "external")&#13;
		.where("state", "installed")&#13;
		.select("sys_id", "subject_common_name", "valid_to")&#13;
		.forEach(function (cert) {&#13;
			var certificateGlideRecord = new GlideRecord("cmdb_ci_certificate");&#13;
			certificateGlideRecord.get(cert.sys_id);&#13;
			var inputs = {};&#13;
			inputs['certificate_ci'] = certificateGlideRecord;&#13;
			inputs['event_type'] = "expiring";&#13;
			try {&#13;
				gs.info(cert.subject_common_name);&#13;
				var flowOutput = sn_fd.FlowAPI.executeSubflow('sn_disco_certmgmt.certificate_event_management', inputs);&#13;
			} catch (ex) {&#13;
				var getErrMsg = (ex.getMessage() || ex.getMessage);&#13;
				gs.error(gs.getMessage('Failed to create certificate task for certificate with sys id {0} : {1}', [certificateGlideRecord.getUniqueValue(), getErrMsg]));&#13;
			}&#13;
		});&#13;
})(inputs, outputs);&#13;
</value>
