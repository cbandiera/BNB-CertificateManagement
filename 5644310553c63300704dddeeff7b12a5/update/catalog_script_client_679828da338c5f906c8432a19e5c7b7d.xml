        <name>Check CN</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
	if (isLoading) {
		return;
	}

	g_form.hideFieldMsg("nome_comum", true);
	if (newValue == "") {
		return;
	}

	var name = newValue.trim();

	// IPv4
	var ipv4Regex =
		/^(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$/;
	// DNS (incluindo wildcard); o último rótulo pode ter dígitos, mas precisa ter uma letra
	var dnsRegex =
		/^(?:\*\.)?([a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?\.)+(?=[a-zA-Z0-9\-]*[a-zA-Z])[a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?$/;

	if (ipv4Regex.test(name) || (dnsRegex.test(name) && name.length <= 253)) {
		return;
	}

	// Apenas aviso: CN não precisa ser hostname, então não bloqueia o envio
	g_form.showFieldMsg(
		"nome_comum",
		"Atenção: " + name + " não parece um nome DNS ou IP. Confira se está correto.",
		"info"
	);
}
]]></script>
