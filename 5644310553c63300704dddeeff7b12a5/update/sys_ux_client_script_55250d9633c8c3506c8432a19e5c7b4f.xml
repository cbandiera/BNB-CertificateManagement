        <name>OnFailureValidateCSR</name>
        <preset/>
        <required_translations>[]</required_translations>
        <script><![CDATA[/**
* @param {params} params
* @param {api} params.api
* @param {any} params.event
* @param {any} params.imports
* @param {ApiHelpers} params.helpers
*/
function handler({api, event, helpers, imports}) {
    /**
     * Sets the CSR validation alert to critical/error state.
     * 
     * Updates the alert to display an "Invalid CSR" message, typically
     * called when CSR validation fails or encounters an error.
     */

    // Immutably update alert - avoid direct mutation of state
    const updatedAlert = [...api.state.validate_csr_alert];
    updatedAlert[0] = {
        ...updatedAlert[0],
        status: 'critical',
        content: 'Invalid CSR'
    };

    api.setState('validate_csr_alert', updatedAlert);
}]]></script>
