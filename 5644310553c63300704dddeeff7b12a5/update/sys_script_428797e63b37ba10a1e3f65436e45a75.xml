        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
	var certUtils = new BNBCertificateMangementUtils();
	var scope = certUtils.getCAScopeFromCN(current.subject_common_name);
	if ("internal" == scope) {
		current.renewal_tracking = "priority1";
	} else if ("external" == scope) {
		current.renewal_tracking = "priority3";
	} else {
		current.setAbortAction(true);
		gs.addErrorMessage(gs.getMessage('Nome Comum (CN) Inválido - não corresponde a certificado Externo ou Interno'));
		return false;
	}

	current.validity_period = gs.getProperty("sn_disco_certmgmt.default_cert_order_validity_period.");
	current.certificate_purpose = scope;

})(current, previous);]]></script>
