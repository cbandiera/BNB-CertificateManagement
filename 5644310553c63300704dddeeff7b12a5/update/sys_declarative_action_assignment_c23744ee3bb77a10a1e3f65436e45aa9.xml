        <script_condition>var certMetadataGr = new GlideRecord("sn_disco_certmgmt_certificate_metadata"); certMetadataGr.addQuery("certificate", current.sys_id); certMetadataGr.addQuery("auto_renew_enabled", true); certMetadataGr.query(); certMetadataGr.hasNext();</script_condition>
        <scripted_client_condition/>
        <server_script><![CDATA[(function executeAction(current, action, gs) {

    var certMetadataGr = new GlideRecord("sn_disco_certmgmt_certificate_metadata");
    certMetadataGr.addQuery("certificate", current.sys_id);
    certMetadataGr.query();
    certMetadataGr.next();

    var result = new CertificateRenewalTaskUtil()
        .triggerRenewal(certMetadataGr.certificate, certMetadataGr, null, 'manual_button');

    if (result && result.renewal_task_id) {

        var taskGr = new GlideRecord('sn_disco_certmgmt_renew_task');
        if (taskGr.get(result.renewal_task_id)) {
            taskGr.work_notes = 'Task de renovação criada com sucesso.';
            taskGr.comments = 'Task de renovação criada com sucesso.';
            taskGr.update();
        }
        gs.addInfoMessage("Task de renovação criada com sucesso.");
    } else {
        gs.addErrorMessage("Erro ao iniciar renovação.");
    }

})(current, action, gs);]]></server_script>
