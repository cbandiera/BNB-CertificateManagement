        <post_insert_script><![CDATA[if (!gs.nil(current.approver)) {
    var approverGR = new GlideRecord('sysapproval_approver');
    approverGR.setValue('approver', current.approver);
    approverGR.setValue('sysapproval', current.sys_id);
    approverGR.setValue('state', 'requested');
    approverGR.insert();
	current.approval = 'requested';
}

//If 'Requested For' field is empty, update the default value is system logged in user id
var userSysId = gs.getUserID();
if (gs.nil(current.requested_for))
	setUserSysIdForFields(['requested_for', 'opened_by']);
else
	setUserSysIdForFields(['opened_by']);

function setUserSysIdForFields(params) {
	var userGR = new GlideRecordSecure('sys_user');
	if (userGR.get(userSysId)) {
		for(var i = 0; i < params.length; i++)
			current[params[i]] = userSysId;
	}
}

/* 
  Mapping the certificate 'Renewal Tracking' priority to certificate task priority
  Certificate task priority options : 1-critical, 2-High, 3-Moderate, 4-Low(This is default priority for catalog task)
  Renewal tracking priority options : priority1 - Create priority 1 tasks, priority3 - Create priority 3 tasks, none - Do not create renewal tasks
*/
if (!gs.nil(current.cmdb_ci)) {
    current.priority = (current.cmdb_ci.renewal_tracking == 'priority3') ? 3 : ((current.cmdb_ci.renewal_tracking == 'priority1') ? 1 : 4);
	current.certificate_expiration_date = current.cmdb_ci.valid_to;
}

current.short_description = gs.getMessage("Task for tracking certificate renewal");
current.description = gs.getMessage("Task for tracking certificate renewal. Please refer to configuration item for more information like affected business services and other details.");
current.update();

//Triggering the custom sub flow: "Certificate task - Record producer customisation"
var inputs = {
	'certificate_task_id': current
};
var flowOutput = sn_fd.FlowAPI.executeSubflow('sn_disco_certmgmt.certificate_task__record_producer_customisation', inputs);]]></post_insert_script>
