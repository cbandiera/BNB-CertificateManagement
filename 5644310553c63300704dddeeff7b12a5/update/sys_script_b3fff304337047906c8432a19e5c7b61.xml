        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	var grIssuer = new GlideRecord('cmdb_ci_certificate');
	grIssuer.addQuery("subject_common_name", current.issuer_common_name);
	grIssuer.query();
	if (grIssuer.next()) {
		current.issuer = grIssuer.sys_id;
		current.root_issuer = grIssuer.sys_id;
	} else {
		current.issuer = null;
		current.root_issuer = null;
	}

})(current, previous);]]></script>
