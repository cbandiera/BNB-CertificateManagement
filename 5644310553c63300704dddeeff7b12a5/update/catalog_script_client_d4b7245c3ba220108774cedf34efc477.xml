function onLoad() {
    //set all the CSR related fields to blank
    csrAttributes.forEach(function(field) {
        g_form.setValue(field, '');
    });

    //Check the catalog form rending at platform UI or Service Portal UI
    var isCatalogFormRenderedAtPlatformUI = checkCatalogFormRenderedAtPlatformUI();
    g_form.setValue('redirect_to_platform_ui', isCatalogFormRenderedAtPlatformUI);
}

function checkCatalogFormRenderedAtPlatformUI() {
    if (typeof GlideURL == 'function') { //GlideURL method not exists in the service portal
        var gURL = new GlideURL();
        gURL.setFromCurrent();
        return gURL.getParam("sysparm_id");
    }
    return '';
}]]></script>
