        <server_script><![CDATA[(function() {
    try {
        var result = sn_fd.FlowAPI.getRunner()
            .action('sn_disco_certmgmt.bnb__obtem_grupos_a_partir_de_propriedades')
            .inForeground()
            .run();

        var outputs = result.getOutputs();
        var grupoInstalacao = outputs['instalacao_de_certificados'];

        if (current.assignment_group != grupoInstalacao) {
            gs.addErrorMessage('Ação não permitida.');
            return;
        }

        var usuario = gs.getUserDisplayName();
        var grupo = current.assignment_group.getDisplayValue();
        var estadoAnterior = current.state.getDisplayValue();

        current.state = '2'; // Completed

        current.comments =
            'Ação executada: Conclusão da tarefa\n' +
            'Usuário: ' + usuario + '\n' +
            'Grupo: ' + grupo + '\n' +
            'Estado anterior: ' + estadoAnterior + '\n' +
            'Novo estado: ' + current.state.getDisplayValue() + '\n' +
			'Resultado: Tarefa marcada como Concluída.';

        current.update();

        gs.addInfoMessage('Tarefa marcada como Concluída.');

    } catch (ex) {
        gs.addErrorMessage('Erro ao concluir tarefa.');
    }
})();]]></server_script>
