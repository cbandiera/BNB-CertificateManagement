 * @param {api} params.api
 * @param {any} params.event
 * @param {any} params.imports
 * @param {ApiHelpers} params.helpers
 */
function handler({
    api,
    event,
    helpers,
    imports
}) {
    /**
     * Opens the certificate renewal modal if triggered by route parameters.
     * 
     * Checks for the 'show-renew-certificate-modal' parameter passed via
     * extraParams and opens the modal accordingly. Typically invoked on
     * component initialization or route change.
     * 
     * @requires api.context.props.extraParams - Route parameter for modal trigger
     */

    const RENEW_MODAL_PARAM = 'show-renew-certificate-modal';
    const RENEW_MODAL_ID = 'renew_certificate_modal';

    const modalParam = api.context.props.extraParams;

    if (modalParam === RENEW_MODAL_PARAM) {
        helpers.modal.open(RENEW_MODAL_ID);

    }
}]]></script>
