        <name>OnCSRSelectChange</name>
        <preset/>
        <required_translations>[]</required_translations>
        <script><![CDATA[/**
* @param {params} params
* @param {api} params.api
* @param {any} params.event
* @param {any} params.imports
* @param {ApiHelpers} params.helpers
*/
function handler({api, event, helpers, imports}) {
    /**
     * Handles CSR option selection change event.
     * 
     * Updates the renew_payload state with the newly selected CSR option
     * while preserving existing payload properties.
     * 
     * @param {Object} event - Event object containing the selected value
     * @param {Object} event.payload.value - The selected CSR option identifier
     */

    const selection = event.payload.value;

    // Immutably update state by spreading existing payload and overwriting selection
    api.setState('renew_payload', {
        ...api.state.renew_payload,
        csr_option_selected: selection
    });
}]]></script>
