        <macroponent display_value="Records in Certificate Management copy">0d25459633c8c3506c8432a19e5c7bb4</macroponent>
        <name>OnCSRTextareaChange</name>
        <preset/>
        <required_translations>[]</required_translations>
        <script><![CDATA[/**
* @param {params} params
* @param {api} params.api
* @param {any} params.event
* @param {any} params.imports
* @param {ApiHelpers} params.helpers
*/
function handler({api, event, helpers, imports}) {
    /**
     * Handles CSR value input change and triggers validation.
     * 
     * Updates the renew_payload state with the new CSR value and
     * initiates asynchronous CSR validation.
     * 
     * @param {Object} event - Event object containing the input value
     * @param {string} event.payload.fieldValue - The CSR value entered by user
     */

    const csrValue = event.payload.fieldValue;

    // Update state with new CSR value
    api.setState('renew_payload', {
        ...api.state.renew_payload,
        csr_value: csrValue
    });

    // Trigger async validation of the CSR
    api.data.validateCSR.execute({ csrValue });
}]]></script>
