<li data-end="835" data-start="809">Criada em: ${sys_created_on}</li>
</ul>
<hr data-end="951" data-start="948">
<p data-end="538" data-start="508"><strong>Certificado</strong></p>
<ul style="list-style-position: inside;">
<li data-end="592" data-start="541">Nome comum do assunto (CN): ${subject_common_name}</li>
<li data-end="592" data-start="541">Nome alternativo: ${subject_alternative_name}</li>
<li data-end="592" data-start="541">Certificate signing request (CSR):
<pre style="font-family: 'courier new', courier, monospace; white-space: pre-wrap; word-wrap: break-word; margin: 0;">${csr}</pre>
</li>
</ul>
