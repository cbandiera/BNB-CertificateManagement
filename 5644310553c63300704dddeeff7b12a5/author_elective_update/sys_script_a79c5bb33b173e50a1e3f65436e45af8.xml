        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
	gs.info('EDX-BR Unique Certificate: ' + current.sys_id + ' - ' + current.root_issuer);
	if (current.subject_common_name.endsWith('bnb.gov.br')) {
		current.u_ca_scope = 'external';
	} else {
		if (current.subject_common_name.endsWith('intra.bnb')
			|| current.subject_common_name.endsWith('dmz.bnb')
			|| current.subject_common_name.endsWith('dreads.bnb')) {
			current.u_ca_scope = 'internal';
			if(current.is_self_signed || current.is_ca || current.root_issuer == null || current.root_issuer == current.sys_id)
				current.setAbortAction(true);
		} else {
			current.u_ca_scope = null;
			return;
		}
	}

})(current, previous);]]></script>
