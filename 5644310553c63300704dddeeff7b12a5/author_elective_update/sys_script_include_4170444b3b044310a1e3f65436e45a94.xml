        <description/>
        <mobile_callable>false</mobile_callable>
        <name>BNBUserUtils</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var BNBUserUtils = Class.create();
BNBUserUtils.prototype = {
	certificadosExternos: "sn_disco_certmgmt.BNB_certificados_externos",
	certificadosInternos: "sn_disco_certmgmt.BNB_certificados_internos",
	instalacaoCertificados: "sn_disco_certmgmt.BNB_instalacao_certificados",

	isMemberOfCertExterno: function () {
		return this._isMemberOfGroup(this.certificadosExternos);
	},

	isMemberOfCertInterno: function () {
		return this._isMemberOfGroup(this.certificadosInternos);
	},

	isMemberOfInstalaCert: function () {
		return this._isMemberOfGroup(this.instalacaoCertificados);
	},

	// Obtem registro da sys_user_group a partid do nome de uma property com o nome do grupo
	getSysUserGroup: function (groupNameProperty) {
		var groupName = gs.getProperty(groupNameProperty, null);

		if (!groupName) {
			throw Error("Propriedade não foi configurada corretamente:  " + groupNameProperty);
		}

		var sysUserGroupGQ = new global.GlideQuery("sys_user_group")
			.getBy({ name: groupName }, ["sys_id", "name"])
			.orElse({ sys_id: null });

		if (!sysUserGroupGQ.sys_id) {
			throw Error("Propriedade <" + groupNameProperty + "> aponta para grupo não existente:  " + groupName);
		}

		return sysUserGroupGQ;
	},

	_isMemberOfGroup: function (groupNameProperty) {
		gs.error("User " + gs.getUser().displayName + " é membro de " + groupNameProperty);
		try {
			if (!gs.getUser()) {
				throw Error("Chamada de função inválida - deve existir usuário logado. Propriedade: " + groupNameProperty);
			}
			var sysUserGroup = this.getSysUserGroup(groupNameProperty);
			var isMember = gs.getUser().isMemberOf(sysUserGroup.name);
			gs.info("User " + gs.getUser().displayName + " é membro de " + sysUserGroup.name + "? " + isMember);
			return isMember;
		} catch (err) {
			throw "EDX - BNBCertUserUtils - " + err.message;
		}
	},

	type: 'BNBUserUtils'
};]]></script>
