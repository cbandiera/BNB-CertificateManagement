        <script><![CDATA[var today = new GlideDateTime();
// today.setValue('2018-05-08');
var beginOfDay = new GlideDateTime(today.getDate() + " 00:00:00");
var endOfDay = new GlideDateTime(today.getDate() + ' 23:59:59');

var i = 30;
var expiraInicio = new GlideDateTime(beginOfDay);
expiraInicio.addDaysLocalTime(i);
var expiraFim = new GlideDateTime(endOfDay);
expiraFim.addDaysLocalTime(i);
// gs.info(i + ' ' + JSON.stringify(expiraInicio) + ' a ' + JSON.stringify(expiraFim));

var ciCertificateGQ = new global.GlideQuery('cmdb_ci_certificate')
  .where("valid_to", ">=", expiraInicio)
  .where("valid_to", "<=", expiraFim)
  .where("is_ca", false)
  .where("u_ca_scope", "external")
  .where("state", "installed")
  .select("sys_id", "subject_common_name", "valid_to")
  .forEach(function(cert) {
	var certificateGlideRecord = new GlideRecord("cmdb_ci_certificate");
	certificateGlideRecord.get(cert.sys_id);
	var inputs = {};
	inputs['certificate_ci'] = certificateGlideRecord;
	inputs['event_type'] = "expiring";
		try {
			gs.info(cert.subject_common_name);
      var flowOutput = sn_fd.FlowAPI.executeSubflow('sn_disco_certmgmt.certificate_event_management', inputs);
		} catch (ex) {
			var getErrMsg = (ex.getMessage() || ex.getMessage);
			gs.error(gs.getMessage('Failed to create certificate task for certificate with sys id {0} : {1}', [certificateGlideRecord.getUniqueValue(), getErrMsg]));
		}
}); ]]></script>
