        <server_script><![CDATA[(function() {
    try {
        var result = sn_fd.FlowAPI.getRunner()
            .action('sn_disco_certmgmt.bnb__obtem_grupos_a_partir_de_propriedades')
            .inForeground()
            .run();

        var outputs = result.getOutputs();
        var grupoExternos = outputs['certificados_externos'];
        var grupoInstalacao = outputs['instalacao_de_certificados'];

        if (current.state != '1' || current.assignment_group != grupoExternos) {
            gs.addErrorMessage('Ação não permitida.');
            return;
        }

        var att = new GlideRecord('sys_attachment');
        att.addQuery('table_name', current.getTableName());
        att.addQuery('table_sys_id', current.sys_id);
        att.query();

        if (!att.hasNext()) {
            gs.addErrorMessage('Anexe o certificado antes de solicitar a instalação.');
            return;
        }

        var usuario = gs.getUserDisplayName();
        var grupoOrigem = current.assignment_group.getDisplayValue();

        current.assignment_group = grupoInstalacao;

        current.comments =
            'Ação executada: Solicitação de instalação de certificado\n' +
            'Usuário: ' + usuario + '\n' +
            'Grupo origem: ' + grupoOrigem + '\n' +
            'Grupo destino: ' + current.assignment_group.getDisplayValue() + '\n' +
            'Tipo de task: ' + current.getTableName() + '\n' +
            'Anexo verificado: Sim\n' +
            'Resultado: Solicitação enviada com sucesso';

        current.update();

        gs.addInfoMessage('Solicitação de instalação enviada com sucesso.');

    } catch (ex) {
        gs.addErrorMessage('Erro ao processar solicitação.');
    }
})();]]></server_script>
